# Copy to /opt/aerotake/.env on the server. Never commit the filled-in file.
# Generate JWT_SIGNING_KEYS and SERVICE_CLIENTS on your laptop:
#   scripts/generate-jwt-keys.sh
#   scripts/generate-service-clients.sh
# Use an alphanumeric POSTGRES_PASSWORD so Compose does not treat $ as interpolation.

POSTGRES_DB=ota
POSTGRES_USER=ota
POSTGRES_PASSWORD=

# Public site. SITE_ADDRESS is the hostname Caddy serves (no scheme).
# Leave SITE_URL empty until Cloudflare resolves; deploy skips the homepage check when it is empty.
SITE_ADDRESS=example.com
SITE_URL=
STOREFRONT_PUBLIC_URL=https://example.com
SSLCOMMERZ_CORE_PUBLIC_URL=https://example.com

JWT_SIGNING_KEYS=
SERVICE_CLIENTS=
FRONTEND_B2C_SERVICE_SECRET=
TENANT_REGISTRY_KEY=

GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_IDS=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SLACK_WEBHOOK_URL=

SABRE_CLIENT_ID=
SABRE_PCC=
SABRE_PASSWORD=
SABRE_API_BASE_URL=https://api.cert.platform.sabre.com
SABRE_JV_CLIENT_ID=
SABRE_JV_CLIENT_SECRET=

HAJEE_API_BASE_URL=
HAJEE_API_ACCESS_KEY=
HAJEE_CLIENT_ID=

SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
